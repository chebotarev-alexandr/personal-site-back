# === Django core ===
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# === Database (defaults to SQLite for local dev) ===
# Postgres example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

# === CORS (comma-separated) ===
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# CSRF trusted origins for HTTPS behind a proxy (comma-separated)
CSRF_TRUSTED_ORIGINS=https://example.com

# === Site ===
TIME_ZONE=Asia/Vladivostok
LANGUAGE_CODE=ru
# Admin URL path (default admin/; change to hide the admin)
ADMIN_URL=admin/

# === Cache (optional Redis: redis://localhost:6379/1) ===
CACHE_URL=

# === Email (for lead notifications) ===
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
LEAD_NOTIFY_EMAIL=

# === Production hardening (set in production only) ===
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=3600
